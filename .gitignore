monografia/*.synctex.gz
monografia/*.toc

# IDEs
.vscode/
.idea/

# Lixo de ferramenta (JupyterLab e logs de servidor)
.virtual_documents/
jupyter_out.log
jupyter_err.log
notebooks/Untitled*.ipynb

# Versionar somente o artefato principal aprovado; RF, ZIPs e experimentos locais
# continuam ignorados. Não excluir o diretório pai: Git precisa percorrê-lo.
/models/*
!/models/xgboost/
/models/xgboost/*
!/models/xgboost/modelo.json
!/models/xgboost/preprocessador.joblib
!/models/xgboost/manifest.json
!/models/xgboost/politica_decisao.json

# Exemplos exportados para a interface (linhas do IEEE-CIS; a competicao
