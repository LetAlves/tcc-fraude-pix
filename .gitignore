# Ambiente Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.mplconfig/
.ipython/
.jupyter/

# Credenciais (NUNCA versionar)
.env
*.kaggle.json

# Dados (arquivos grandes ficam fora do git)
data/raw/
data/processed/
data/rag/raw/
data/rag/processed/
data/rag/index/*
!data/rag/index/index.faiss
!data/rag/index/metadata.jsonl
!data/rag/index/manifest.json
data/rag/manifest.json

# Outputs de notebooks
.ipynb_checkpoints/

# Relatórios e figuras geradas
reports/*.png
reports/*.txt

# Exceções: evidência citada de tarefas concluídas (maio, m1_p1_3 / m1_p1_4).
# São os artefatos que a entrega parcial 1 referencia; sem versioná-los, o
# documento aponta para arquivos que só existem na máquina de quem os gerou.
!reports/eda_summary.txt
!reports/fig_distribuicao_alvo.png
!reports/fig_top_correlacoes.png

# Artefatos de compilação LaTeX/Overleaf
monografia/*.aux
monografia/*.bbl
monografia/*.bcf
monografia/*.blg
monografia/*.fdb_latexmk
monografia/*.fls
monografia/*.log
monografia/*.out
