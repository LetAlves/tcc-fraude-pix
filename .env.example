# Copie este arquivo para .env e preencha com suas credenciais Kaggle
# Gere a chave em: https://www.kaggle.com/settings → API → Create New Token

KAGGLE_USERNAME=seu_usuario_kaggle
KAGGLE_KEY=sua_chave_api_kaggle

# Opcional: mantenha os CSVs grandes fora de pastas sincronizadas.
# TCC_DATA_RAW=C:\dados\ieee-fraud-detection
